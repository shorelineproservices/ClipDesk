# Copy to .env on BOTH machines (push-to-mac.ps1 copies it). Never commit .env.
OFFICE_TOKEN=            # shared secret for every write to HQ; `python -m office token` prints the generated one
OFFICE_URL=http://<HQ-TAILSCALE-IP>:8800   # where HQ runs (its Tailscale IP). Workers and the CLI use this.
NTFY_TOPIC=              # ntfy.sh topic for phone pushes (optional)
# Optional free cloud keys; without them everything runs on local Ollama
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_URL=http://127.0.0.1:11434    # this machine's Ollama (default)
